rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidPost(data) {
      return data.keys().hasAll(['id', 'title', 'content', 'author', 'created_at']) &&
             data.keys().hasOnly(['id', 'title', 'content', 'author', 'author_realm', 'tag', 'upvotes', 'downvotes', 'image_url', 'created_at', 'last_activity_at']) &&
             data.id is number &&
             data.title is string && data.title.size() >= 3 && data.title.size() <= 300 &&
             data.content is string && data.content.size() >= 5 && data.content.size() <= 10000 &&
             data.author is string && data.author.size() >= 1 && data.author.size() <= 100 &&
             (!('author_realm' in data) || (data.author_realm is string && data.author_realm.size() <= 100)) &&
             (!('tag' in data) || (data.tag is string && data.tag.size() <= 50)) &&
             (!('upvotes' in data) || data.upvotes is number) &&
             (!('downvotes' in data) || data.downvotes is number) &&
             (!('image_url' in data) || (data.image_url is string && data.image_url.size() <= 2048)) &&
             data.created_at is string && data.created_at.size() <= 100 &&
             (!('last_activity_at' in data) || (data.last_activity_at is string && data.last_activity_at.size() <= 100));
    }

    function isValidComment(data) {
      return data.keys().hasAll(['id', 'post_id', 'author', 'content', 'created_at']) &&
             data.keys().hasOnly(['id', 'post_id', 'parent_id', 'author', 'author_realm', 'content', 'upvotes', 'image_url', 'created_at']) &&
             data.id is number &&
             data.post_id is number &&
             (!('parent_id' in data) || data.parent_id == null || data.parent_id is number) &&
             data.author is string && data.author.size() >= 1 && data.author.size() <= 100 &&
             (!('author_realm' in data) || (data.author_realm is string && data.author_realm.size() <= 100)) &&
             data.content is string && data.content.size() >= 1 && data.content.size() <= 2000 &&
             (!('upvotes' in data) || data.upvotes is number) &&
             (!('image_url' in data) || (data.image_url is string && data.image_url.size() <= 2048)) &&
             data.created_at is string && data.created_at.size() <= 100;
    }

    function isValidChatMessage(data) {
      return data.keys().hasAll(['id', 'room', 'author', 'content', 'created_at']) &&
             data.keys().hasOnly(['id', 'room', 'author', 'author_realm', 'badge_color', 'content', 'created_at', 'reactions', 'realm', 'mentions']) &&
             data.id is number &&
             data.room is string && data.room.size() <= 50 &&
             data.author is string && data.author.size() >= 1 && data.author.size() <= 100 &&
             (!('author_realm' in data) || (data.author_realm is string && data.author_realm.size() <= 100)) &&
             (!('badge_color' in data) || (data.badge_color is string && data.badge_color.size() <= 20)) &&
             data.content is string && data.content.size() >= 1 && data.content.size() <= 5000 &&
             data.created_at is string && data.created_at.size() <= 100 &&
             (!('reactions' in data) || data.reactions is map);
    }

    function isValidSession(data) {
      return data.keys().hasAll(['id', 'nickname', 'created_at', 'expires_at']) &&
             data.keys().hasOnly(['id', 'nickname', 'email', 'realm', 'flair', 'created_at', 'last_active_at', 'expires_at']) &&
             data.id is string && data.id.size() <= 128 &&
             data.nickname is string && data.nickname.size() >= 1 && data.nickname.size() <= 100 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 255)) &&
             (data.keys().hasAny(['realm']) || data.keys().hasAny(['flair'])) &&
             data.created_at is string && data.created_at.size() <= 100 &&
             (!('last_active_at' in data) || (data.last_active_at is string && data.last_active_at.size() <= 100)) &&
             data.expires_at is string && data.expires_at.size() <= 100;
    }

    function isValidRealm(data) {
      return data.keys().hasAll(['id', 'name', 'created_at']) &&
             data.keys().hasOnly(['id', 'name', 'badge_color', 'icon', 'image_icon', 'short_name', 'description', 'is_default', 'created_at']) &&
             data.id is string && data.id.size() <= 100 &&
             data.name is string && data.name.size() <= 100 &&
             (!('badge_color' in data) || (data.badge_color is string && data.badge_color.size() <= 20)) &&
             (!('icon' in data) || (data.icon is string && data.icon.size() <= 20)) &&
             (!('image_icon' in data) || (data.image_icon is string && data.image_icon.size() <= 2048)) &&
             (!('short_name' in data) || (data.short_name is string && data.short_name.size() <= 16)) &&
             (!('description' in data) || (data.description is string && data.description.size() <= 500)) &&
             (!('is_default' in data) || data.is_default is bool) &&
             data.created_at is string && data.created_at.size() <= 100;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['email', 'nickname', 'created_at']) &&
             data.keys().hasOnly(['email', 'nickname', 'realm', 'flair', 'created_at', 'last_updated_at']) &&
             data.email is string && data.email.size() <= 255 &&
             data.nickname is string && data.nickname.size() >= 1 && data.nickname.size() <= 100 &&
             (data.keys().hasAny(['realm']) || data.keys().hasAny(['flair'])) &&
             data.created_at is string && data.created_at.size() <= 100 &&
             (!('last_updated_at' in data) || (data.last_updated_at is string && data.last_updated_at.size() <= 100));
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['id', 'userId', 'messageId', 'type', 'read', 'created_at']) &&
             data.keys().hasOnly(['id', 'userId', 'messageId', 'type', 'read', 'created_at']) &&
             data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 100 &&
             data.messageId is number &&
             data.type in ['chat', 'post', 'comment'] &&
             data.read is bool &&
             data.created_at is string && data.created_at.size() <= 100;
    }

    match /posts/{postId} {
      allow read: if true;
      allow write: if isValidPost(incoming());
    }

    match /comments/{commentId} {
      allow read: if true;
      allow write: if isValidComment(incoming());
    }

    match /chat_messages/{messageId} {
      allow read: if true;
      allow write: if isValidChatMessage(incoming());
    }

    match /sessions/{sessionId} {
      allow read: if true;
      allow write: if isValidSession(incoming());
    }

    match /users/{email} {
      allow read: if true;
      allow write: if isValidUser(incoming());
    }

    match /realms/{realmId} {
      allow read: if true;
      allow write: if isValidRealm(incoming());
    }

    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if isValidNotification(incoming());
    }
  }
}
