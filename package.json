{
  "name": "fansphere",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --exclude 'data/**' server.ts",
    "build": "tsc && npm run build:css",
    "build:css": "node_modules/.bin/tailwindcss -i ./static/style.css -o ./static/dist/style.css",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "firebase": "^13.0.0",
    "multer": "^2.4.0",
    "sharp": "^0.35.5",
    "tsx": "^4.19.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.2",
    "@types/sharp": "^0.31.1",
    "@types/ws": "^8.5.13",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.12.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.7.2"
  }
}
